# Copia para .env e ajusta. Nunca faças commit do .env.
# MySQL (Homebrew): cria a base e o utilizador conforme o README.
DATABASE_URL=mysql+pymysql://triage_user:CHANGE_ME@127.0.0.1:3306/smart_triage
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SQL_ECHO=false
# Cria as tabelas no arranque (útil em desenvolvimento). Em alternativa usa: alembic upgrade head
AUTO_CREATE_TABLES=true
